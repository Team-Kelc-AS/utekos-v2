{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "utekos-v2",
  "homepage": "https://utekos.no",
  "include": ["components/ui/registry.json", "hooks/registry.json"],
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@shadcnblocks": "https://www.shadcnblocks.com/r/{style}/{name}"
  }
}
